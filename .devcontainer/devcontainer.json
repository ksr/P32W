{
    // P32W in a GitHub codespace (D96): VS Code in a browser on a Linux machine, with
    // the cross tools, both emulators and P32W Unix's disk built once, at creation.
    // .devcontainer/README.md (opened at the start) says how to use it.
    "name": "P32W",
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
    "hostRequirements": { "cpus": 2 },
    // the tests compare P32W's programs with the host's build of them: clang, as a Mac's cc
    // (gcc evaluates arguments right to left, and folds some overflows otherwise)
    "containerEnv": { "HOSTCC": "clang" },
    "postCreateCommand": "sh .devcontainer/setup.sh",
    // the debugger (tools/p32dbg, D97): its page opens in a new tab when it starts
    "portsAttributes": { "8832": { "label": "P32W debugger", "onAutoForward": "openBrowser" } },
    "customizations": {
        "codespaces": { "openFiles": [".devcontainer/README.md"] },
        "vscode": {
            "settings": { "terminal.integrated.sendKeybindingsToShell": true }
        }
    }
}
