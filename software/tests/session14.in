cd /tmp
cat > corrupt.c <<END
/* corrupt.c -- break the ram disk's filesystem on purpose: a bitmap bit, a link count */
#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
int main(void)
{
    unsigned char b[1024];
    int fd = open("/dev/ram", O_RDWR);
    lseek(fd, 5 * 1024, 0); read(fd, b, 1024);
    b[0] &= ~(1 << 6);                  /* block 6 (the root directory) marked free */
    lseek(fd, 5 * 1024, 0); write(fd, b, 1024);
    lseek(fd, 1 * 1024, 0); read(fd, b, 1024);
    b[2 * 64 + 2] = 5;                  /* inode 2's link count: 5 */
    lseek(fd, 1 * 1024, 0); write(fd, b, 1024);
    close(fd);
    return 0;
}
END
cc -o corrupt corrupt.c
./corrupt
/etc/fsck /dev/ram
echo status $?
/etc/fsck -y /dev/ram
echo status $?
/etc/fsck /dev/ram
echo status $?
halt
